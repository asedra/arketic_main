# Arketic AI Application - Environment Variables

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Full database connection URL
DATABASE_URL=postgresql://arketic_user:arketic_password@localhost:5432/arketic_db

# Individual database connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=arketic_user
POSTGRES_PASSWORD=arketic_password
POSTGRES_DB=arketic_db

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret key for JWT token signing (use a strong, random string in production)
JWT_SECRET=arketic-super-secret-jwt-key-2024
# Token expiration time (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# OpenAI API key for LangChain.js integration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Backend API URL for frontend requests
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# DOCKER DEVELOPMENT SETTINGS
# =============================================================================
# Enable file watching for Docker development (Linux/WSL)
WATCHPACK_POLLING=true

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env in the project root
# 2. Update the values according to your environment
# 3. Never commit .env files to version control
# 4. For production, use strong passwords and secure secrets
# 5. Ensure OPENAI_API_KEY is set for AI functionality

# Example production values:
# JWT_SECRET=your-256-bit-secret-key-here
# POSTGRES_PASSWORD=very-secure-password-123
# OPENAI_API_KEY=sk-your-actual-openai-api-key